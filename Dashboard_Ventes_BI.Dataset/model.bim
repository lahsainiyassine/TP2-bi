          },
          {
            "name": "mode_paiement",
            "dataType": "string",
            "sourceColumn": "mode_paiement"
          }
        ],
        "measures": [
          {
            "name": "Chiffre d'Affaires Total",
            "expression": "SUM(fait_ventes[montant_total])",
            "formatString": "#,0.00 \"DH\""
          },
          {
            "name": "Quantité Totale Vendue",
            "expression": "SUM(fait_ventes[quantite_vendue])",
            "formatString": "#,0"
          },
          {
            "name": "Nombre de Transactions",
            "expression": "COUNTROWS(fait_ventes)",
            "formatString": "#,0"
          },
          {
            "name": "Panier Moyen",
            "expression": "DIVIDE([Chiffre d'Affaires Total], [Nombre de Transactions], 0)",
            "formatString": "#,0.00 \"DH\""
          },
          {
            "name": "Prix Moyen Unitaire",
            "expression": "AVERAGE(fait_ventes[prix_unitaire])",
            "formatString": "#,0.00 \"DH\""
          }
        ],
        "partitions": [
          {
            "name": "fait_ventes",
